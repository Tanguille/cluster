#shellcheck disable=SC2148,SC2155

# Puts the mise-managed toolchain on PATH and applies .mise.toml's [env], so repo commands run as
# `just talos ...` rather than `mise exec -- just talos ...`.
#
# Deliberately not `use mise`: that needs a helper installed per machine
# (`mise direnv activate > ~/.config/direnv/lib/use_mise.sh`) and hard-fails this whole file when
# it is missing. This form needs no setup. watch_file makes direnv reload on a toolchain change,
# which `use mise` would otherwise have given us for free.
#
# Not using direnv at all? The shims give the same result:
#   fish_add_path ~/.local/share/mise/shims           # fish
#   export PATH="$HOME/.local/share/mise/shims:$PATH" # bash/zsh
if has mise; then
  watch_file .mise.toml
  eval "$(mise env -s bash)"
fi

# Directory paths
export ROOT_DIR="$PWD"
export KUBERNETES_DIR="$ROOT_DIR/kubernetes"
export SCRIPTS_DIR="$ROOT_DIR/scripts"

# Sops configuration
export SOPS_CONFIG_FILE="$ROOT_DIR/.sops.yaml"

# Venv
PATH_add "$(expand_path ./.venv/bin)"
export VIRTUAL_ENV="$(expand_path ./.venv)"
export PYTHONDONTWRITEBYTECODE="1"

# Bin
PATH_add "$(expand_path ./.bin)"

# KUBECONFIG, SOPS_AGE_KEY_FILE, TALOSCONFIG and JUST_UNSTABLE are deliberately NOT set here.
# `use mise` applies them from .mise.toml's [env], which is the single source of truth. They were
# duplicated in both files and drifted: this file still pointed TALOSCONFIG at the retired
# talos/clusterconfig/ path after mise had moved on.
