#shellcheck disable=SC2148,SC2155

# Puts the mise-managed toolchain on PATH and applies .mise.toml's [env].
# Not `use mise`: it needs a helper installed per machine and hard-fails this file without it.
# No direnv? `export PATH="$HOME/.local/share/mise/shims:$PATH"` gives the same result.
if has mise; then
  watch_file .mise.toml
  # Captured before eval: `eval "$(mise env)"` reports eval's status, not mise's, so a config
  # error would leave every repo tool off PATH with no indication why.
  if mise_env="$(mise env -s bash)"; then
    eval "$mise_env"
  else
    log_error "mise env failed; repo tools (talosctl, minijinja-cli, sops) are not on PATH"
  fi
fi

# Venv
PATH_add "$(expand_path ./.venv/bin)"
export VIRTUAL_ENV="$(expand_path ./.venv)"
export PYTHONDONTWRITEBYTECODE="1"

# Bin
PATH_add "$(expand_path ./.bin)"
