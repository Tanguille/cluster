---
# TrueNAS hypervisor VM on 192.168.0.27. Only GPU node: R9700 (amdgpu) and RTX 2070 (nvidia).
machine:
  install:
    disk: /dev/vda
  nodeLabels:
    # GPU label for applications; the amdgpu kernel module is loaded
    # automatically by the siderolabs/amdgpu system extension
    amd.com/gpu: "true"
    nvidia.com/gpu: "true"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: control-1
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("00:16:3e:97:0e:d8", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: {{ vip }}
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 192.168.0.11/24
routes:
  - gateway: {{ gateway }}
---
# virtio-blk reports every disk as rotational; both zvols sit on a PLP PM983 (docs/drives.md), and
# rotational=1 gave osd.3 BlueStore HDD settings and a 377-IOPS mClock budget. Discards are capped
# at 256 MiB like the NVMe rule in cluster.yaml.j2: the 2 GiB virtio default let the weekly trim
# push etcd fsync p99 to 88 ms (2026-11-13).
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  - ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="vd[a-z]", ATTR{queue/rotational}="0", ATTR{queue/discard_max_bytes}="268435456"
---
# The nvidia extension blacklists its modules (nvidia.conf), so each must be loaded explicitly.
# nvidia_uvm is the one CUDA needs; nvidia_modeset has no DRM side effect. nvidia_drm with modeset=1
# is for wolf (kubernetes/apps/games/fenrir, disabled for now), whose compositor renders through GBM on the 2070's
# render node. It adds a second DRM card next to the R9700, and the squat plugin hands all of
# /dev/dri to jellyfin, fileflows and vllm: those must keep finding the R9700 as renderD128.
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_uvm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_modeset
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_drm
parameters:
  - modeset=1
---
# nvidia-container-cli needed this on 1.14; kept until the 1.15 NRI toolkit is confirmed without it.
# Merges with the SysctlConfig in cluster.yaml.j2, the node layer adds keys.
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.core.bpf_jit_harden: "1"
