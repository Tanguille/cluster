---
# TrueNAS hypervisor VM on 192.168.0.27. Only GPU node: R9700 (amdgpu) and RTX 2070 (nvidia).
machine:
  install:
    disk: /dev/vda
    # Its own schematic (control-1.schematic.yaml: qemu-guest-agent, GPU extensions and kernel args), so its own installer
    # repo -- control-2/3 share talos/schematic.yaml and cannot use this image.
    image: ghcr.io/tanguille/installer/control-1:{{ pinned }}
  nodeLabels:
    # GPU label for applications; the amdgpu kernel module is loaded
    # automatically by the siderolabs/amdgpu system extension
    amd.com/gpu: "true"
    nvidia.com/gpu: "true"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: control-1
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("00:16:3e:97:0e:d8", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: {{ vip }}
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 192.168.0.11/24
routes:
  - gateway: {{ gateway }}
---
# virtio-blk reports every disk as rotational; both zvols sit on a PLP PM983 (docs/drives.md), and
# rotational=1 gave osd.3 BlueStore HDD settings and a 377-IOPS mClock budget. Discards are capped
# at 256 MiB like the NVMe rule in cluster.yaml.j2: the 2 GiB virtio default let the weekly trim
# push etcd fsync p99 to 88 ms (2026-11-13).
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  - ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="vd[a-z]", ATTR{queue/rotational}="0", ATTR{queue/discard_max_bytes}="268435456"
---
# The nvidia extension blacklists its modules (nvidia.conf), so each must be loaded explicitly.
# nvidia_drm is left out on purpose: it defaults to modeset=1 and would add a second DRM card
# next to the R9700 (the squat plugin hands all of /dev/dri to jellyfin, fileflows and vllm), and
# CUDA, NVENC and the toolkit do not need it. If something does, load it with modeset=0 (no DRM
# device is registered). nvidia_uvm is the one CUDA needs; nvidia_modeset has no DRM side effect.
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_uvm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_modeset
---
# The nvidia-container-toolkit extension requires this. Merges with the SysctlConfig in
# cluster.yaml.j2, the node layer adds keys.
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.core.bpf_jit_harden: "1"
