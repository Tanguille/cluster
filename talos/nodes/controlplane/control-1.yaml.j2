---
# TrueNAS hypervisor VM on 192.168.0.27. Only node with the dGPU (R9700).
machine:
  install:
    disk: /dev/vda
    # Its own schematic (control-1.schematic.yaml: qemu-guest-agent, dGPU kernel args), so its own installer
    # repo -- control-2/3 share talos/schematic.yaml and cannot use this image.
    image: ghcr.io/tanguille/installer/control-1:{{ pinned }}
  nodeLabels:
    # GPU label for applications; the amdgpu kernel module is loaded
    # automatically by the siderolabs/amdgpu system extension
    amd.com/gpu: "true"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: control-1
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("00:16:3e:97:0e:d8", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: {{ vip }}
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 192.168.0.11/24
routes:
  - gateway: {{ gateway }}
---
# virtio-blk reports every disk as rotational; both zvols sit on a PLP PM983 (docs/drives.md), and
# rotational=1 gave osd.3 BlueStore HDD settings and a 377-IOPS mClock budget.
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  - ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="vd[a-z]", ATTR{queue/rotational}="0"
