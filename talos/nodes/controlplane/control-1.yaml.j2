---
# TrueNAS hypervisor VM on 192.168.0.27. Only node with the dGPU (R9700).
machine:
  install:
    disk: /dev/vda
    image: factory.talos.dev/installer/{{ schematic }}:{{ talosVersion }}
  nodeLabels:
    # GPU label for applications; the amdgpu kernel module is loaded
    # automatically by the siderolabs/amdgpu system extension
    amd.com/gpu: "true"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: control-1
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("00:16:3e:97:0e:d8", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 192.168.0.2
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 192.168.0.11/24
routes:
  - gateway: 192.168.0.1
