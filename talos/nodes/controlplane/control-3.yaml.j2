---
# Chuwi ubox. Runs in-cluster Kepler. Install disk is selected by model because the
# Micron 7450 has a thermal-shutdown history and must stay unambiguous across reseats; the
# model tells the 480GB system disk from the 960GB OSD without publishing its serial.
# Only a fresh install reads the selector; upgrades reuse the running system disk.
machine:
  install:
    diskSelector:
      model: Micron_7450_MTFDKBA480TFR
    # Shared with control-2 (same schematic). Our registry, not the Factory: tuppr rebuilds the
    # upgrade target from this field, so leaving it on factory.talos.dev reinstalls the stock kernel.
    image: ghcr.io/tanguille/installer/shared:{{ pinned }}
  nodeLabels:
    amd.com/igpu: "true"
    kepler-node: "true"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: control-3
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("84:47:09:6d:18:a4", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: {{ vip }}
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 192.168.0.13/24
routes:
  - gateway: {{ gateway }}
