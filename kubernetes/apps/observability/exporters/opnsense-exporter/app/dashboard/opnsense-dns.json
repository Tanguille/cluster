{
  "title": "OPNsense DNS",
  "uid": "opnsense-dns",
  "tags": ["network", "opnsense", "unbound"],
  "editable": true,
  "refresh": "",
  "schemaVersion": 39,
  "timezone": "browser",
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Dropped lookups",
      "description": "Share of lookups Unbound abandoned after discard-timeout, so the client got no answer. It sat near 1.6% while the Tuya hub was flapping; UnboundDroppingLookups fires above 0.5% for 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(opnsense_unbound_stat{name=\"total.num.queries_discard_timeout\"}[$__rate_interval])) / sum(rate(opnsense_unbound_stat{name=\"total.num.queries\"}[$__rate_interval]))",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recursion time",
      "description": "Time Unbound waits on the Cloudflare DoT upstream for names not in cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "opnsense_unbound_stat{name=\"total.recursion.time.avg\"}",
          "legendFormat": "average"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "opnsense_unbound_stat{name=\"total.recursion.time.median\"}",
          "legendFormat": "median"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Share of lookups answered from cache, including expired answers served while refreshing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(opnsense_unbound_stat{name=\"total.num.cachehits\"}[$__rate_interval])) / sum(rate(opnsense_unbound_stat{name=\"total.num.queries\"}[$__rate_interval]))",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(opnsense_unbound_stat{name=\"num.answer.rcode.SERVFAIL\"}[$__rate_interval])) / sum(rate(opnsense_unbound_stat{name=\"total.num.queries\"}[$__rate_interval]))",
          "legendFormat": "SERVFAIL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lookups per second",
      "description": "All client lookups, and those arriving over TCP (limited by incoming-num-tcp).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(opnsense_unbound_stat{name=\"total.num.queries\"}[$__rate_interval]))",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(opnsense_unbound_stat{name=\"num.query.tcp\"}[$__rate_interval]))",
          "legendFormat": "tcp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache memory",
      "description": "Unbound RRset and message cache size; the DNSBL lives outside these.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "opnsense_unbound_stat{name=\"mem.cache.rrset\"}",
          "legendFormat": "rrset"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "opnsense_unbound_stat{name=\"mem.cache.message\"}",
          "legendFormat": "message"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
