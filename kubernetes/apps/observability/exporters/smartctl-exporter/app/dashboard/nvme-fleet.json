{
  "uid": "nvme-fleet",
  "title": "NVMe Fleet",
  "tags": ["hardware", "nvme", "smartctl"],
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Endurance used, worst device",
      "description": "smartctl_device_percentage_used — NVMe percentage used, most-worn device in the fleet. 80% = replacement window, 90% = replace now (NVMeWear / NVMeWearCritical).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(smartctl_device_percentage_used{device=~\"nvme.*\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "minValue": 0,
        "maxValue": 100,
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Spare capacity, min across fleet",
      "description": "smartctl_device_available_spare — falls as spare blocks get consumed. NVMeSpareLow fires below the vendor threshold (10%).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(smartctl_device_available_spare{device=~\"nvme.*\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "minValue": 0,
        "maxValue": 100,
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Device temperature",
      "description": "NVMe device temperature per instance/device. NVMeHot alerts on a 10m average above 70C.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_temperature{device=~\"nvme.*\"}",
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Inventory",
      "description": "One row per NVMe: endurance, spare, media errors, power-on hours, bytes written.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(smartctl_device{device=~\"nvme.*\"}) by (instance, device, model_name, serial_number)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_percentage_used{device=~\"nvme.*\"}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_available_spare{device=~\"nvme.*\"}"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_media_errors{device=~\"nvme.*\"}"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_power_on_seconds{device=~\"nvme.*\"} / 3600"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_bytes_written{device=~\"nvme.*\"}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Endurance %" },
              { "id": "unit", "value": "percent" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Spare %" },
              { "id": "unit", "value": "percent" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #D" },
            "properties": [
              { "id": "displayName", "value": "Media errors" },
              { "id": "unit", "value": "none" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #E" },
            "properties": [
              { "id": "displayName", "value": "Power-on hours" },
              { "id": "unit", "value": "h" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #F" },
            "properties": [
              { "id": "displayName", "value": "Bytes written" },
              { "id": "unit", "value": "bytes" }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns" }
        },
        {
          "id": "merge"
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "instance": {
                "aggregations": [],
                "operation": "groupby"
              },
              "device": {
                "aggregations": [],
                "operation": "groupby"
              },
              "model_name": {
                "aggregations": [],
                "operation": "groupby"
              },
              "serial_number": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value #B": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              },
              "Value #C": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              },
              "Value #D": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              },
              "Value #E": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              },
              "Value #F": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "job": true,
              "prometheus": true
            }
          }
        }
      ]
    }
  ]
}
