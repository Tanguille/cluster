      "description": "Per deployment: healthy, partial (below desired replicas) or outage (none available).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "2 * (kube_deployment_status_replicas_available{namespace=\"ai\",deployment=~\"agentgateway|headroom|embedding-cache|qwen38-27b-vllm|qwen35-2b|embeddinggemma-2|bge-reranker-v2-m3|omniroute\"} == bool 0) + (kube_deployment_status_replicas_available{namespace=\"ai\",deployment=~\"agentgateway|headroom|embedding-cache|qwen38-27b-vllm|qwen35-2b|embeddinggemma-2|bge-reranker-v2-m3|omniroute\"} < bool kube_deployment_spec_replicas{namespace=\"ai\",deployment=~\"agentgateway|headroom|embedding-cache|qwen38-27b-vllm|qwen35-2b|embeddinggemma-2|bge-reranker-v2-m3|omniroute\"}) * (kube_deployment_status_replicas_available{namespace=\"ai\",deployment=~\"agentgateway|headroom|embedding-cache|qwen38-27b-vllm|qwen35-2b|embeddinggemma-2|bge-reranker-v2-m3|omniroute\"} > bool 0)",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green"
                },
                "1": {
                  "text": "partial",
                  "color": "orange"
                },
                "2": {
                  "text": "outage",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 7
      }
