{
  "uid": "vllm-kv-tiers",
  "title": "vLLM KV cache tiers",
  "description": "Where cached prompt tokens come from: GPU prefix cache (device), CPU offload tier (host), fs tier (disk). Counted at admission from vllm:prompt_tokens_cached_by_source (vllm#56318).",
  "tags": ["inference", "vllm"],
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "vLLM runtime",
      "type": "link",
      "url": "/d/llmkube-vllm",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tokens from host + disk tiers",
      "description": "Share of cached prompt tokens served by the offload tiers over the range. The rest came from the GPU prefix cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(increase(vllm:prompt_tokens_cached_by_source_total{source!=\"device\"}[$__range])) / sum(increase(vllm:prompt_tokens_cached_by_source_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cached prompt tokens/s by tier",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(vllm:prompt_tokens_cached_by_source_total[$__rate_interval]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["mean", "max"],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 6
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Share of cached tokens by tier",
      "description": "Each tier's part of all cached prompt tokens. Host and disk read 0 while the GPU cache covers the prefix; they matter after eviction or a restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(vllm:prompt_tokens_cached_by_source_total[$__rate_interval])) / scalar(sum(rate(vllm:prompt_tokens_cached_by_source_total[$__rate_interval])))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["mean", "max"],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      }
    }
  ]
}
