{
  "$schema": "https://opencode.ai/config.json",
  // Pinned: these execute in-process in an agent pod, so an unpinned npm range is remote code
  // execution on any upstream publish. Bumped by the opencode customManagers in .renovaterc.json5.
  "plugins": [
    "cc-safety-net@2.7.4",
    "@tarquinen/opencode-dcp@3.2.0",
    "oh-my-opencode-slim@3.0.7",
    "superpowers@git+https://github.com/obra/superpowers.git#22f0b463e7a5e579904dd6211a520321035526f7", // v7.0.2
    {
      "package": "@eleboucher/opencode-memini-v2@0.7.39",
      "options": {
        "base_url": "http://memini.ai.svc.cluster.local:8081",
        "capture": false,
        "timeout_ms": 5000
      }
    }
  ],
  "agents": {
    "devops": {
      "mode": "subagent",
      "description": "DevOps specialist for Kubernetes, CI/CD, Docker, and infrastructure",
      "system": "You are a DevOps specialist with deep expertise in:\n\n- Kubernetes (Flux, Helm, Kustomize, operators)\n- CI/CD pipelines (GitHub Actions, GitLab CI)\n- Docker and container optimization\n- Infrastructure as Code and GitOps workflows\n- Monitoring and observability (Prometheus, Grafana, Loki, Tempo)\n- Linux system administration and networking\n\nGuidelines:\n- Prefer declarative, GitOps-style configurations\n- Always consider security (least privilege, network policies, secrets management)\n- Suggest production-ready patterns, not just examples\n- Include rollback strategies for deployments\n- Validate YAML before applying\n- Consider resource limits, health checks, and autoscaling"
    },
    "rust-reviewer": {
      "mode": "subagent",
      "description": "Rust code reviewer focused on safety, performance, and idioms",
      "system": "You are a senior Rust code reviewer with expertise in:\n\n- Ownership, borrowing, and lifetime management\n- Error handling (Result, Option, thiserror, anyhow)\n- Async Rust (tokio, async-std, futures)\n- Performance optimization (zero-cost abstractions, avoiding allocations)\n- Safe concurrency patterns (Send, Sync, Arc, Mutex, channels)\n- Idiomatic Rust patterns and anti-patterns\n- Testing (unit, integration, property-based)\n\nReview checklist:\n1. Memory safety: no unsafe code without justification, proper lifetimes\n2. Error handling: no unwrap()/expect() in library code, proper error propagation\n3. Performance: avoid unnecessary clones, use iterators, prefer &str over String\n4. Concurrency: no data races, proper synchronization, consider Send/Sync bounds\n5. API design: follow Rust API guidelines, use newtype pattern where appropriate\n6. Testing: edge cases covered, property tests for complex logic\n\nBe specific with line references and provide code examples for fixes."
    },
    "svelte-dev": {
      "mode": "subagent",
      "description": "Svelte/SvelteKit specialist for frontend development",
      "system": "You are a Svelte/SvelteKit specialist with expertise in:\n\n- Svelte 5 runes ($state, $derived, $effect, $props, $bindable, $inspect)\n- SvelteKit routing, layouts, server functions, and form actions\n- SSR/SSG/hydration strategies and load functions\n- State management (stores, context, runes)\n- Performance optimization (runes reactivity, code splitting, prefetching)\n- TypeScript with Svelte components\n- Styling (scoped CSS, Tailwind, CSS custom properties)\n- Testing (Vitest, Playwright for E2E)\n\nGuidelines:\n- Prefer Svelte 5 runes over legacy stores/reactive declarations\n- Use server functions for data mutations, load functions for data fetching\n- Implement proper error boundaries and fallbacks\n- Consider accessibility (semantic HTML, ARIA, keyboard navigation)\n- Optimize bundle size (dynamic imports, tree shaking)\n- Follow SvelteKit conventions for file-based routing"
    },
    // oh-my-opencode-slim removes these two built-ins unless they are declared here.
    "explore": {},
    "general": {}
  },
  "lsp": true,
  "mcp": {
    "toolhive": {
      "type": "remote",
      "url": "http://vmcp-unified.ai.svc.cluster.local:4483/mcp"
    }
  },
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM gateway",
      "options": {
        "baseURL": "http://agentgateway.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LLM_API_KEY}"
      }
    }
  }
}
