{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  // Pinned: these execute in-process in an agent pod, so an unpinned npm range is remote code
  // execution on any upstream publish. Bumped by the opencode customManager in .renovaterc.json5.
  "plugin": [
    "cc-safety-net@2.6.19",
    "@tarquinen/opencode-dcp@3.2.0",
    "oh-my-opencode-slim@3.0.6"
  ],
  "mcp": {
    "toolhive": {
      "type": "remote",
      "url": "http://vmcp-unified.ai.svc.cluster.local:4483/mcp"
    }
  },
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM gateway",
      "options": {
        "baseURL": "http://agentgateway.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LLM_API_KEY}"
      }
    }
  }
}
