{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  // Pinned: these execute in-process in an agent pod, so an unpinned npm range is remote code
  // execution on any upstream publish. No Renovate manager covers this file yet.
  "plugin": [
    "cc-safety-net@1.0.6",
    "@tarquinen/opencode-dcp@3.1.14",
    "oh-my-opencode-slim@2.2.10"
  ],
  "mcp": {
    "toolhive": {
      "type": "remote",
      "url": "http://vmcp-unified.ai.svc.cluster.local:4483/mcp",
      "enabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}
