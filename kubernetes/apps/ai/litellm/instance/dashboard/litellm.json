    {
      "id": 21,
      "type": "state-timeline",
      "title": "Deployment health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Worst state across litellm pods.",
      "targets": [
        {
          "expr": "max by (litellm_model_name) (litellm_deployment_state)",
          "legendFormat": "{{litellm_model_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green"
                },
                "1": {
                  "text": "partial",
                  "color": "orange"
                },
                "2": {
                  "text": "outage",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 7
      }
