          "expr": "sum by (litellm_model_name) (rate(litellm_deployment_latency_per_output_token_count{litellm_model_name!~\".*embedding.*\"}[$__rate_interval])) / sum by (litellm_model_name) (rate(litellm_deployment_latency_per_output_token_sum{litellm_model_name!~\".*embedding.*\"}[$__rate_interval]))",
          "legendFormat": "{{litellm_model_name}}",
