{{- /* Flux fills ${VAR} from cluster-settings and cluster-secrets; helmfile does not, so substitute here. */ -}}
{{- $values := (fromYaml (readFile (printf "../../../kubernetes/apps/%s/%s/app/helmrelease.yaml" .Release.Namespace .Release.Name))).spec.values | toYaml -}}
{{- $vars := (fromYaml (readFile "../../../kubernetes/components/common/cluster-settings.yaml")).data -}}
{{- $vars = merge $vars (exec "sops" (list "-d" "--extract" "[\"stringData\"]" "../../../kubernetes/components/common/cluster-secrets.sops.yaml") | fromYaml) -}}
{{- range $k, $v := $vars }}{{ $values = $values | replace (printf "${%s}" $k) (toString $v) }}{{ end -}}
{{ $values }}
