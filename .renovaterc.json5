{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'abandonments:recommended',
    'github>home-operations/renovate-presets#8.1.0',
    'github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0',
    'github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0',
    'github>home-operations/renovate-presets//apps/llamacpp.json5#8.1.0',
    'github>home-operations/renovate-presets//apps/searxng.json5#8.1.0',
    ':timezone(Europe/Brussels)',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
  ],
  customDatasources: {
    'linux-kernel': {
      defaultRegistryUrlTemplate: 'https://www.kernel.org/releases.json',
      format: 'json',
      transformTemplates: [
        '{"releases":[releases[moniker="stable" and iseol=false].{"version": version, "changelogUrl": changelog}], "homepage": "https://www.kernel.org"}',
      ],
    },
  },
  customManagers: [
    {
      description: 'tuppr target v<talos>-k<kernel>: Talos half',
      customType: 'regex',
      managerFilePatterns: [
        '/tuppr/upgrades/talosupgrade\\.yaml$/',
      ],
      matchStrings: [
        'version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?)-k',
      ],
      depNameTemplate: 'siderolabs/talos',
      datasourceTemplate: 'github-releases',
    },
    {
      description: 'tuppr target v<talos>-k<kernel>: kernel half',
      customType: 'regex',
      managerFilePatterns: [
        '/tuppr/upgrades/talosupgrade\\.yaml$/',
      ],
      matchStrings: [
        '-k(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)',
      ],
      depNameTemplate: 'linux',
      datasourceTemplate: 'custom.linux-kernel',
    },
    {
      description: 'GrafanaDashboard spec.url pinned to GitHub release tags',
      customType: 'regex',
      managerFilePatterns: [
        '/grafanadashboard\\.yaml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'url:\\s+"?https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      description: 'qBitrr ConfigVersion (semver, no v prefix)',
      customType: 'regex',
      managerFilePatterns: [
        '/qbitrr/config/config\\.toml$/',
      ],
      matchStrings: [
        'ConfigVersion\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'feramance/qbitrr',
      datasourceTemplate: 'docker',
      autoReplaceStringTemplate: 'ConfigVersion = "{{{newValue}}}"',
    },
    {
      description: 'HuggingFace model files revision-pinned in llmkube Model sources (HF model repos are git repos; digest = repo commit sha)',
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/apps/ai/llmkube/models/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'source:\\s+https://huggingface\\.co/(?<depName>[^/\\s]+/[^/\\s]+)/resolve/(?<currentDigest>[a-f0-9]{40})/',
        'source:\\s+hf://(?<depName>[^/\\s]+/[^/\\s]+)@(?<currentDigest>[a-f0-9]{40})',
      ],
      packageNameTemplate: 'https://huggingface.co/{{depName}}',
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
    },
    {
      description: 'opencode npm plugins (executed in-process in an agent pod, so they stay pinned)',
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/apps/ai/opencode/app/config/opencode\\.jsonc$/',
      ],
      matchStrings: [
        '"(?<depName>@?[\\w.-]+(?:/[\\w.-]+)?)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      datasourceTemplate: 'npm',
    },
    {
      description: 'CNPG Database CRD vector extension version pin',
      customType: 'regex',
      managerFilePatterns: [
        '/resourceset\\.yaml$/',
      ],
      matchStrings: [
        'name:\\s+vector\\b(?:\\n[ \\t]*|\\n +[^-\\s][^\\n]*)*?\\n +version:\\s*["\']?(?<currentValue>\\d+\\.\\d+\\.\\d+)["\']?',
      ],
      depNameTemplate: 'ghcr.io/cloudnative-pg/pgvector',
      datasourceTemplate: 'docker',
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+\\.\\d+)-\\d+-\\w+$',
    },
  ],
  packageRules: [
    {
      description: 'Paiton accepts only its hash-pinned checkpoint; bump with the image',
      matchDepNames: [
        'unsloth/Qwen3.8-27B-NVFP4',
      ],
      enabled: false,
    },
    {
      description: 'Auto-merge trusted OCI digests',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      matchPackageNames: [
        '/home-operations/',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'Auto-merge searxng',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/searxng/searxng',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'vllm-openai-rocm nightly digest — the rolling `nightly` tag is digest-pinned so Renovate can detect new builds at all; never auto-merge, a bump rolls the single-GPU serving pod and can move the KV pool that maxModelLen is sized against',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'vllm/vllm-openai-rocm',
      ],
      automerge: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/anomalyco/opencode',
      ],
      allowedVersions: '1.18.x',
      automerge: false,
    },
    {
      description: 'Actions Runner Controller Group',
      groupName: 'actions-runner-controller',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/gha-runner-scale-set/',
      ],
      minimumGroupSize: 2,
    },
    {
      description: 'Flux Operator Group',
      groupName: 'flux-operator',
      matchDatasources: [
        'docker',
        'github-releases',
      ],
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
      ],
      minimumGroupSize: 2,
    },
    {
      description: 'Talos Group',
      groupName: 'talos',
      matchDatasources: [
        'docker',
        'github-releases',
      ],
      matchPackageNames: [
        '/siderolabs\\//',
      ],
    },
    {
      description: 'Rook-Ceph Group',
      groupName: 'rook-ceph',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/rook-ceph/',
      ],
      minimumGroupSize: 2,
    },
    {
      description: 'ToolHive operator and CRDs group',
      groupName: 'toolhive',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/stacklok\\/toolhive\\/toolhive-operator/',
      ],
      minimumGroupSize: 2,
    },
    {
      description: 'ToolHive MCP server images group',
      groupName: 'toolhive-mcp',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'kubernetes/apps/ai/toolhive/config/**',
      ],
      matchPackageNames: [
        '!registry.k8s.io/kubectl',
      ],
    },
    {
      description: 'VectorChord CNPG images and Memini database version',
      groupName: 'vectorchord',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/tensorchord/vchord-scratch',
      ],
    },
    {
      description: 'pgvector CNPG extension image and Database CRD version pins',
      groupName: 'pgvector',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/pgvector',
      ],
    },
    {
      description: 'Group klipper-exporter image and Grafana dashboard URL',
      groupName: 'klipper-exporter',
      matchDatasources: [
        'docker',
        'github-releases',
      ],
      matchPackageNames: [
        '/prometheus-klipper-exporter/',
      ],
    },
    {
      description: 'nginx sidecar images group',
      groupName: 'nginx',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nginx',
      ],
      minimumGroupSize: 2,
    },
    {
      description: 'qBitrr: group image tag and ConfigVersion',
      groupName: 'qbitrr',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'kubernetes/apps/media/qbittorrent/tools/qbitrr/**',
      ],
      matchPackageNames: [
        '/feramance\\/qbitrr/',
      ],
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'kubernetes/apps/media/qbittorrent/tools/qbitrr/config/config.toml',
      ],
      matchPackageNames: [
        '/feramance\\/qbitrr/',
      ],
      extractVersion: '^v(?<version>.*)$',
    },
    {
      description: 'shellcheck releases rarely; not abandoned',
      matchDepNames: [
        'aqua:koalaman/shellcheck',
      ],
      abandonmentThreshold: null,
    },
    {
      description: 'Mixed-segment tags (p2pool v4.15/v4.15.1, hermes v2026.5.29/v2026.5.29.2); docker versioning skips patch bumps',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/sethforprivacy/p2pool',
        'nousresearch/hermes-agent',
      ],
      versioning: 'loose',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'type/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      addLabels: [
        'type/digest',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/container',
      ],
    },
    {
      matchDatasources: [
        'custom.grafana-dashboards',
      ],
      addLabels: [
        'renovate/grafana-dashboard',
      ],
    },
    {
      matchDatasources: [
        'custom.linux-kernel',
      ],
      versioning: 'loose',
      semanticCommitScope: 'kernel',
      addLabels: [
        'renovate/kernel',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-action',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      addLabels: [
        'renovate/github-release',
      ],
    },
  ],
}
