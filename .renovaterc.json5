{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    // v6 flattened every config/managers/overrides/policies file into default.json and moved
    // app-specific presets to apps/, opt-in only — the old config/baseConfig.json5 etc. paths
    // this repo's default.json used to extend no longer exist past 5.0.0, which is why pinning
    // "github>home-operations/renovate-presets#5.0.0" started failing to resolve: nested extends
    // in their default.json carry no ref of their own, so Renovate re-resolves them against the
    // default branch (now v7's flat layout) instead of inheriting the #5.0.0 pin.
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    // apps/grafanaDashboards.json5 inlined below: its grafanaCom template needs capture groups
    // Renovate never passes to templates, so every dashboard bump failed with "update failure".
    "github>home-operations/renovate-presets//apps/llamacpp.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0",
    // talosFactory preset dropped: it matches factory.talos.dev tags and every node pins
    // ghcr.io/tanguille/installer/*. Its custom.talos-factory datasource is wrong for the tuppr
    // target too -- that reads what the Factory can build, we gate on the siderolabs git tag.
    ":timezone(Europe/Brussels)"
  ],
  ignorePaths: ["**/*.sops.*", "**/resources/**"],
  // main has no required checks, so GitHub native auto-merge would merge before CI finishes;
  // with this off Renovate merges itself only once every check is green (needs Checks: read).
  platformAutomerge: false,
  // In-issue "trigger a run" button (the cloud dashboard had one). The operator's webhook
  // fires on any issue edit containing a checked box (mogenius/renovate-operator
  // src/webhook/renovateCheckbox.go: it greps for "- [x]" in Renovate's dashboard body,
  // no comment marker required), so an
  // unchecked box in the footer = one click to schedule a run. The box resets to unchecked
  // on every dashboard rewrite.
  dependencyDashboardFooter: "- [ ] <!-- trigger-run --> **Trigger a new run** — checking this box schedules an immediate run (like the cloud dashboard's button).",
  customDatasources: {
    // Filtering on the moniker, not a version range, is what survives a series bump
    // (7.1.x -> 7.2.x) with no config change. Not a git mirror: gregkh/linux carries mainline
    // and -rc tags in the same stream, so Renovate would offer -rc builds as updates.
    // Feed shape verified against the live endpoint: {"releases":[{"moniker","version",
    // "changelog","iseol",...}], "latest_stable":{...}}.
    // Re-check with: curl -s https://www.kernel.org/releases.json | jq '.releases[]|select(.moniker=="stable")'
    // If the shape ever changes the transform yields zero releases and bumps stop SILENTLY.
    "linux-kernel": {
      defaultRegistryUrlTemplate: "https://www.kernel.org/releases.json",
      format: "json",
      transformTemplates: [
        '{"releases":[releases[moniker="stable" and iseol=false].{"version": version, "changelogUrl": changelog}], "homepage": "https://www.kernel.org"}'
      ]
    },
    "grafana-dashboards": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/dashboards/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases":[{"version": $string(revision)}], "sourceDirectory": name}'
      ]
    }
  },
  customManagers: [
    {
      // One manager per half: an inline annotation takes the whole value and reads -k as a
      // semver prerelease. Optional prerelease group so an rc pin still matches.
      description: "tuppr target v<talos>-k<kernel>: Talos half",
      customType: "regex",
      managerFilePatterns: ["/tuppr/upgrades/talosupgrade\\.yaml$/"],
      matchStrings: [
        "version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?)-k"
      ],
      depNameTemplate: "siderolabs/talos",
      datasourceTemplate: "github-releases"
    },
    {
      // Span is "-k<version>", not the version line: Renovate rewrites currentValue inside the
      // span, and "v1.17.3-k7.3" contains "7.3" twice. Cost: every -k<digits> in the file is its
      // own dep. depName linux matches the Dockerfile ARG, so both land in one branch.
      description: "tuppr target v<talos>-k<kernel>: kernel half",
      customType: "regex",
      managerFilePatterns: ["/tuppr/upgrades/talosupgrade\\.yaml$/"],
      matchStrings: ["-k(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      depNameTemplate: "linux",
      datasourceTemplate: "custom.linux-kernel"
    },
    {
      description: "GrafanaDashboard spec.url pinned to GitHub release tags",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        'url:\\s+"?https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/'
      ],
      datasourceTemplate: "github-releases"
    },
    {
      // Only adjacent id then revision: `indentation` is the one custom group a template can use.
      description: "GrafanaDashboard grafanaCom id/revision",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "grafanaCom:\\n(?<indentation> +)id: (?<depName>\\d+)\\n +revision: (?<currentValue>\\d+)"
      ],
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
      autoReplaceStringTemplate: "grafanaCom:\n{{{indentation}}}id: {{{depName}}}\n{{{indentation}}}revision: {{{newValue}}}"
    },
    {
      description: "qBitrr ConfigVersion (semver, no v prefix)",
      customType: "regex",
      managerFilePatterns: ["/qbitrr/config/config\\.toml$/"],
      matchStrings: ['ConfigVersion\\s*=\\s*"(?<currentValue>[^"]+)"'],
      depNameTemplate: "feramance/qbitrr",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^v(?<version>.*)$",
      // newValue is already v-stripped by extractVersionTemplate, so write it verbatim. (A
      // {{replace}} here would re-extract empty and abort the branch with "update failure".)
      autoReplaceStringTemplate: 'ConfigVersion = "{{{newValue}}}"'
    },
    {
      description: "HuggingFace model files revision-pinned in llmkube Model sources (HF model repos are git repos; digest = repo commit sha)",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/ai/llmkube/models/.+\\.ya?ml$/"],
      // Two source forms in use: the resolve/ URL for single-file GGUFs, and
      // hf://repo@sha for multi-file repos (qwen38). Without the
      // second, the primary serving model's weights digest tracks nothing.
      matchStrings: [
        "source:\\s+https://huggingface\\.co/(?<depName>[^/\\s]+/[^/\\s]+)/resolve/(?<currentDigest>[a-f0-9]{40})/",
        "source:\\s+hf://(?<depName>[^/\\s]+/[^/\\s]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      packageNameTemplate: "https://huggingface.co/{{depName}}",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs"
    },
    {
      description: "opencode npm plugins (executed in-process in an agent pod, so they stay pinned)",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/ai/opencode/app/config/opencode\\.jsonc$"
      ],
      matchStrings: [
        '"(?<depName>@?[\\w.-]+(?:/[\\w.-]+)?)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'
      ],
      datasourceTemplate: "npm"
    },
    {
      // Mirrors the cnpg.json5 preset's vchord manager (that one only matches "vchord"), so the
      // Database CR's vector version pin tracks the pgvector OCI image tag in cluster.yaml
      // instead of drifting silently against the base postgresql image.
      description: "CNPG Database CRD vector extension version pin",
      customType: "regex",
      managerFilePatterns: ["/resourceset\\.yaml$/"],
      matchStrings: [
        "name:\\s+vector\\b(?:\\n[ \\t]*|\\n +[^-\\s][^\\n]*)*?\\n +version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      depNameTemplate: "ghcr.io/cloudnative-pg/pgvector",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^(?<version>\\d+\\.\\d+\\.\\d+)-\\d+-\\w+$"
    }
  ],
  packageRules: [
    {
      description: "Paiton accepts only its hash-pinned checkpoint; bump with the image",
      matchDepNames: ["unsloth/Qwen3.8-27B-NVFP4"],
      enabled: false
    },
    // Auto-merge rules: later rules override earlier ones, so the deny-list comes last.
    {
      description: "Auto-merge patch and digest bumps once they have aged 3 days",
      matchUpdateTypes: ["patch", "digest"],
      // Quay exposes no releaseTimestamp to the docker datasource, and the custom.linux-kernel
      // datasource (depName "linux") has none either — leaving them in this rule is what
      // prints the releaseTimestamp warning(s) on every run. Excluded here, they are simply
      // not aged: same effective behaviour as before (timestamp-optional meant no gating),
      // without the dashboard noise. (Their auto-merge is preserved by the
      // re-enable rule placed after the storage/network deny-list below.)
      excludePackageNames: ["/quay.io/", "linux"],
      minimumReleaseAge: "3 days",
      // Some registries (e.g. quay.io) publish no release timestamps; required would pend them forever.
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: true,
      automergeType: "pr"
    },
    {
      description: "Auto-merge GitHub Actions on minor too",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr"
    },
    {
      description: "Auto-merge Renovate's own image on minor",
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr"
    },
    {
      description: "Never auto-merge storage, network, control plane, databases or GPU serving",
      matchPackageNames: [
        "/talos/",
        "/installer/",
        "/siderolabs/",
        "/tuppr/",
        "/cilium/",
        "/coredns/",
        "/envoy/",
        "/k8s-gateway/",
        "/external-dns/",
        "/cert-manager/",
        "/spegel/",
        "/rook/",
        "/ceph/",
        "/openebs/",
        "/kopiur/",
        "/snapshot-controller/",
        "/cloudnative-pg/",
        "/postgres/",
        "/vchord/",
        "/pgvector/",
        "/dragonfly/",
        "/flux/",
        "/vllm/",
        "/llama/"
      ],
      automerge: false
    },
    // The exclude in the release-age rule above removes the excluded packages from that
    // rule's automerge as well (a packageRule applies all its fields at once). Re-enable it
    // for exactly them — placed AFTER the deny-list above so ceph/cilium etc. stay manual —
    // keeping the effective behaviour unchanged: with timestamp-optional the 3-day gate was
    // never gating them (no releaseTimestamp), so auto-merge is as before.
    {
      description: "Keep auto-merge for the packages excluded from the release-age rule",
      matchPackageNames: ["/quay.io/", "linux"],
      matchUpdateTypes: ["patch", "digest"],
      // Full mirror of the deny-list above: a rule later in the list wins, so without these
      // the re-enable would override the deny-list's automerge:false for every deny-listed
      // quay.io package (ceph, cilium, rook, kepler, ...). A pattern like "/kepler/" also
      // matches quay.io/.../charts/kepler-operator, which a narrow list would miss. (The
      // linux-kernel depName is forced manual by the custom.linux-kernel labeling rule at
      // the end of the list, which comes after this one.)
      excludePackageNames: [
        "/talos/",
        "/installer/",
        "/siderolabs/",
        "/tuppr/",
        "/cilium/",
        "/coredns/",
        "/envoy/",
        "/k8s-gateway/",
        "/external-dns/",
        "/cert-manager/",
        "/spegel/",
        "/rook/",
        "/ceph/",
        "/openebs/",
        "/kopiur/",
        "/snapshot-controller/",
        "/cloudnative-pg/",
        "/postgres/",
        "/vchord/",
        "/pgvector/",
        "/dragonfly/",
        "/flux/",
        "/vllm/",
        "/llama/"
      ],
      automerge: true,
      automergeType: "pr"
    },
    {
      description: "Auto-merge searxng",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      automerge: true,
      automergeType: "pr"
    },
    {
      description: "vllm-openai-rocm nightly digest — the rolling `nightly` tag is digest-pinned so Renovate can detect new builds at all; never auto-merge, a bump rolls the single-GPU serving pod and can move the KV pool that maxModelLen is sized against",
      matchDatasources: ["docker"],
      matchPackageNames: ["vllm/vllm-openai-rocm"],
      automerge: false
    },
    {
      // opencode 2.x is not deployable yet: v2.0.0 changed the server API surface (see
      // anomalyco/opencode packages/app/V1_API_MIGRATION.md) and every 2.0.x pod failed
      // the /:4096 HTTP liveness/readiness probes, leaving the HelmRelease
      // Stalled/RetriesExceeded (Flux rolled back to 1.18.30 on 2026-09-15).
      // Hold at 1.18.x until the chart probes/values are migrated to the v2 API.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anomalyco/opencode"],
      allowedVersions: "1.18.x",
      automerge: false
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      // matches both gha-runner-scale-set and gha-runner-scale-set-controller
      matchPackageNames: ["/gha-runner-scale-set/"],
      minimumGroupSize: 2
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      // github-releases: the pinned flux-operator dashboard URLs in flux-instance/app/grafanadashboard.yaml
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      minimumGroupSize: 2
    },
    {
      // talosupgrade.yaml and the mise talosctl pin track the same Talos release — one PR
      // instead of two. Nothing here moves during a pre-release (config:recommended sets
      // ignoreUnstable), which is how a third copy in the flate workflow drifted four releases.
      description: "Talos Group",
      groupName: "talos",
      matchDatasources: ["docker", "github-releases"],
      // matches all siderolabs/* packages (talos, installer, etc.); both slashes are regex
      // delimiters, so the inner one must stay escaped AND closed or config validation fails
      matchPackageNames: ["/siderolabs\\//"]
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      // matches both rook-ceph and rook-ceph-cluster
      matchPackageNames: ["/rook-ceph/"],
      minimumGroupSize: 2
    },
    {
      description: "ToolHive operator and CRDs group",
      groupName: "toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/stacklok\\/toolhive\\/toolhive-operator/"],
      minimumGroupSize: 2
    },
    {
      description: "ToolHive MCP server images group",
      groupName: "toolhive-mcp",
      matchDatasources: ["docker"],
      matchFileNames: ["kubernetes/apps/ai/toolhive/config/**"],
      // vmcp-restart.yaml's kubectl image: excluded so a kubectl bump doesn't ride
      // along with the MCP server images in this group.
      matchPackageNames: ["!registry.k8s.io/kubectl"]
    },
    {
      description: "VectorChord CNPG images and Memini database version",
      groupName: "vectorchord",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"]
    },
    {
      description: "pgvector CNPG extension image and Database CRD version pins",
      groupName: "pgvector",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgvector"]
    },
    {
      description: "Group klipper-exporter image and Grafana dashboard URL",
      groupName: "klipper-exporter",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/prometheus-klipper-exporter/"]
    },
    {
      description: "nginx sidecar images group",
      groupName: "nginx",
      matchDatasources: ["docker"],
      matchPackageNames: ["nginx"],
      minimumGroupSize: 2
    },
    {
      // No matchManagers on purpose: the HelmRelease image is detected by both helm-values and
      // kubernetes (home-ops points both at every .yaml); constraining managers let one copy
      // escape into a duplicate PR. datasource+file+package already scope this precisely.
      description: "qBitrr: group image tag and ConfigVersion",
      groupName: "qbitrr",
      matchDatasources: ["docker"],
      matchFileNames: ["kubernetes/apps/media/qbittorrent/tools/qbitrr/**"],
      matchPackageNames: ["/feramance\\/qbitrr/"]
    },
    {
      // Last release 2025-08-04, past `abandonments:recommended`, but still used by pre-commit.
      // matchPackageNames misses: the mise preset rewrites packageName to koalaman/shellcheck.
      description: "shellcheck releases rarely; not abandoned",
      matchDepNames: ["aqua:koalaman/shellcheck"],
      abandonmentThreshold: null
    },
    // Versioning overrides
    {
      description: "Mixed-segment tags (p2pool v4.15/v4.15.1, hermes v2026.5.29/v2026.5.29.2); docker versioning skips patch bumps",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/sethforprivacy/p2pool",
        "nousresearch/hermes-agent"
      ],
      versioning: "loose"
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"]
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"]
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"]
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"]
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"]
    },
    {
      matchDatasources: ["custom.grafana-dashboards"],
      addLabels: ["renovate/grafana-dashboard"],
      commitMessageTopic: "dashboard {{sourceDirectory}}",
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore"
    },
    {
      matchDatasources: ["custom.linux-kernel"],
      // stable is X.Y.Z most of the time but a bare X.Y for a freshly promoted series, which
      // semver rejects — the update would silently stop. The annotation syntax cannot carry a
      // versioning field, so it has to be set here.
      versioning: "loose",
      semanticCommitScope: "kernel",
      addLabels: ["renovate/kernel"],
      // Kernel point releases are "patch"; keep them manual.
      automerge: false
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"]
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"]
    }
  ]
}
