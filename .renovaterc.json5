{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    // Pin every github> preset to the same tag; an unpinned one tracks main.
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    // grafanaDashboards preset inlined below: its grafanaCom template needs capture groups Renovate never passes to templates.
    "github>home-operations/renovate-presets//apps/llamacpp.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0"
    // talosFactory preset omitted: nodes pin ghcr.io/tanguille/installer/* and tuppr gates on the siderolabs git tag.
  ],
  ignorePaths: ["**/*.sops.*", "**/resources/**"],
  // The operator webhook starts a run on any ticked dashboard checkbox; Renovate resets it on rewrite.
  dependencyDashboardFooter: "- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository",
  // Overrides :automergeBranch from the base preset.
  automergeType: "pr",
  // main has no required checks, so GitHub native auto-merge would merge before CI finishes;
  // with this off Renovate merges itself only once every check is green (needs Checks: read).
  platformAutomerge: false,
  // GHCR/Quay/OCI publish no release timestamps; timestamp-required would hold their updates forever.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // "strict" (default) parks aging updates under "Pending Status Checks"; "flexible" opens the PR and automerge waits on the stability check.
  internalChecksFilter: "flexible",
  // Keeps the timestamp-optional warning off the dashboard.
  logLevelRemap: [
    {
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: "info"
    }
  ],
  customDatasources: {
    // Moniker filter survives series bumps; a git mirror would offer -rc tags.
    // A feed shape change yields zero releases and bumps stop SILENTLY; check: curl -s https://www.kernel.org/releases.json | jq '.releases[]|select(.moniker=="stable")'
    "linux-kernel": {
      defaultRegistryUrlTemplate: "https://www.kernel.org/releases.json",
      format: "json",
      transformTemplates: [
        '{"releases":[releases[moniker="stable" and iseol=false].{"version": version, "changelogUrl": changelog}], "homepage": "https://www.kernel.org"}'
      ]
    },
    "grafana-dashboards": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/dashboards/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases":[{"version": $string(revision)}], "sourceDirectory": name}'
      ]
    }
  },
  customManagers: [
    {
      // One manager per half: an inline annotation takes the whole value and reads -k as a
      // semver prerelease. Optional prerelease group so an rc pin still matches.
      description: "tuppr target v<talos>-k<kernel>: Talos half",
      customType: "regex",
      managerFilePatterns: ["/tuppr/upgrades/talosupgrade\\.yaml$/"],
      matchStrings: [
        "version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?)-k"
      ],
      depNameTemplate: "siderolabs/talos",
      datasourceTemplate: "github-releases"
    },
    {
      // Span is "-k<version>", not the version line: Renovate rewrites currentValue inside the
      // span, and "v1.17.3-k7.3" contains "7.3" twice. depName linux matches the Dockerfile ARG, so both land in one branch.
      description: "tuppr target v<talos>-k<kernel>: kernel half",
      customType: "regex",
      managerFilePatterns: ["/tuppr/upgrades/talosupgrade\\.yaml$/"],
      matchStrings: ["-k(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      depNameTemplate: "linux",
      datasourceTemplate: "custom.linux-kernel"
    },
    {
      description: "GrafanaDashboard spec.url pinned to GitHub release tags",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        'url:\\s+"?https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/'
      ],
      datasourceTemplate: "github-releases"
    },
    {
      // Only adjacent id then revision: `indentation` is the one custom group a template can use.
      description: "GrafanaDashboard grafanaCom id/revision",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "grafanaCom:\\n(?<indentation> +)id: (?<depName>\\d+)\\n +revision: (?<currentValue>\\d+)"
      ],
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
      autoReplaceStringTemplate: "grafanaCom:\n{{{indentation}}}id: {{{depName}}}\n{{{indentation}}}revision: {{{newValue}}}"
    },
    {
      description: "qBitrr ConfigVersion (semver, no v prefix)",
      customType: "regex",
      managerFilePatterns: ["/qbitrr/config/config\\.toml$/"],
      matchStrings: ['ConfigVersion\\s*=\\s*"(?<currentValue>[^"]+)"'],
      depNameTemplate: "feramance/qbitrr",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^v(?<version>.*)$",
      // newValue is already v-stripped by extractVersionTemplate, so write it verbatim. (A
      // {{replace}} here would re-extract empty and abort the branch with "update failure".)
      autoReplaceStringTemplate: 'ConfigVersion = "{{{newValue}}}"'
    },
    {
      description: "HuggingFace model files revision-pinned in llmkube Model sources (HF model repos are git repos; digest = repo commit sha)",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/ai/llmkube/models/.+\\.ya?ml$/"],
      // Two source forms: resolve/<sha> URL (single-file GGUFs) and hf://repo@sha (multi-file repos).
      matchStrings: [
        "source:\\s+https://huggingface\\.co/(?<depName>[^/\\s]+/[^/\\s]+)/resolve/(?<currentDigest>[a-f0-9]{40})/",
        "source:\\s+hf://(?<depName>[^/\\s]+/[^/\\s]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      packageNameTemplate: "https://huggingface.co/{{depName}}",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs"
    },
    {
      description: "Paperclip Instance image: split repository/tag/digest fields",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/ai/paperclip/instance/instance\\.yaml$/"
      ],
      matchStrings: [
        "repository: (?<depName>\\S+)\\n\\s+tag: (?<currentValue>\\S+)\\n\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      datasourceTemplate: "docker"
    },
    {
      description: "opencode npm plugins (executed in-process in an agent pod, so they stay pinned)",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/ai/opencode/app/config/opencode\\.jsonc$/"
      ],
      matchStrings: [
        '"(?<depName>@?[\\w.-]+(?:/[\\w.-]+)?)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'
      ],
      datasourceTemplate: "npm"
    }
  ],
  packageRules: [
    // Auto-merge rules: later rules override earlier ones, so the deny-list comes last.
    {
      description: "Auto-merge patch and digest bumps once they have aged 3 days",
      matchUpdateTypes: ["patch", "digest"],
      minimumReleaseAge: "3 days",
      automerge: true
    },
    {
      description: "Auto-merge GitHub Actions on minor too",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      // 0.x minors are breaking; the preset leaves this guard to us.
      matchCurrentVersion: "!/^v?0\\./",
      minimumReleaseAge: "3 days",
      automerge: true
    },
    {
      description: "Auto-merge Renovate's own image on minor",
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      automerge: true
    },
    {
      description: "Auto-merge searxng",
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      automerge: true
    },
    {
      // Owner's own site: a merge to rsume master is the release decision, so skip the 3-day wait.
      description: "Publish rsume immediately",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tanguille/rsume"],
      minimumReleaseAge: "0 days",
      automerge: true
    },
    {
      description: "Never auto-merge kritika: pre-1.0, its chart values change between patches",
      matchPackageNames: ["/kritika/"],
      automerge: false
    },
    {
      description: "Never auto-merge storage, network, control plane, databases or GPU serving",
      matchPackageNames: [
        "/talos/",
        "/installer/",
        "/siderolabs/",
        "/tuppr/",
        "/cilium/",
        "/coredns/",
        "/envoy/",
        "/k8s-gateway/",
        "/external-dns/",
        "/cert-manager/",
        "/spegel/",
        "/rook/",
        "/ceph/",
        "/openebs/",
        "/kopiur/",
        "/snapshot-controller/",
        "/cloudnative-pg/",
        "/postgres/",
        "/vchord/",
        "/dragonfly/",
        "/flux/",
        "/vllm/",
        "/llama/",
        "/obico/"
      ],
      automerge: false
    },
    {
      // opencode 2.x changed the server API (probes fail); hold at 1.18.x until the chart is migrated.
      matchPackageNames: ["ghcr.io/anomalyco/opencode"],
      allowedVersions: "1.18.x",
      automerge: false
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      // matches both gha-runner-scale-set and gha-runner-scale-set-controller
      matchPackageNames: ["/gha-runner-scale-set/"],
      minimumGroupSize: 2
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      minimumGroupSize: 2
    },
    {
      // talosupgrade.yaml and the mise talosctl pin (github-tags) move together in one PR.
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["/siderolabs/"]
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      // matches both rook-ceph and rook-ceph-cluster
      matchPackageNames: ["/rook-ceph/"],
      minimumGroupSize: 2
    },
    {
      description: "ToolHive operator and CRDs group",
      groupName: "toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/stacklok\\/toolhive\\/toolhive-operator/"],
      minimumGroupSize: 2
    },
    {
      description: "ToolHive MCP server images group",
      groupName: "toolhive-mcp",
      matchDatasources: ["docker"],
      matchFileNames: ["kubernetes/apps/ai/toolhive/mcp/**"]
    },
    {
      description: "VectorChord CNPG images and Memini database version",
      groupName: "vectorchord",
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"]
    },
    {
      description: "obico web and ml-api images move together",
      groupName: "obico",
      matchPackageNames: ["/gabe565\\/obico/"],
      minimumGroupSize: 2
    },
    {
      description: "Group klipper-exporter image and Grafana dashboard URL",
      groupName: "klipper-exporter",
      matchPackageNames: ["/prometheus-klipper-exporter/"]
    },
    {
      description: "nginx sidecar images group",
      groupName: "nginx",
      matchDatasources: ["docker"],
      matchPackageNames: ["nginx"],
      minimumGroupSize: 2
    },
    {
      // No matchManagers on purpose: flux and helm-values both detect the HelmRelease image,
      // and constraining managers let one copy escape into a duplicate PR.
      description: "qBitrr: group image tag and ConfigVersion",
      groupName: "qbitrr",
      matchDatasources: ["docker"],
      matchFileNames: ["kubernetes/apps/media/qbittorrent/tools/qbitrr/**"],
      matchPackageNames: ["/feramance\\/qbitrr/"]
    },
    {
      // Last release 2025-08-04, past `abandonments:recommended`, but still a pinned mise tool.
      description: "shellcheck releases rarely; not abandoned",
      matchPackageNames: ["koalaman/shellcheck"],
      abandonmentThreshold: null
    },
    {
      // Image labels point at the rocky-kiwi build repo; ceph has no GitHub releases, so this yields compare links only.
      matchPackageNames: ["quay.io/ceph/ceph"],
      sourceUrl: "https://github.com/ceph/ceph"
    },
    {
      // The preset override gives docker.io but re-extraction gives mirror.gcr.io: "depName mismatch".
      description: "Keep envoy-gateway's helmfile depName on mirror.gcr.io so it edits with the OCIRepository",
      matchManagers: ["helmfile"],
      matchPackageNames: ["docker.io/envoyproxy/gateway-helm"],
      overrideDepName: "mirror.gcr.io/envoyproxy/gateway-helm"
    },
    // Versioning overrides
    {
      description: "Mixed-segment tags (p2pool v4.15/v4.15.1, hermes v2026.5.29/v2026.5.29.2); docker versioning skips patch bumps",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/sethforprivacy/p2pool",
        "nousresearch/hermes-agent"
      ],
      versioning: "loose"
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      addLabels: ["type/{{updateType}}"]
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"]
    },
    {
      matchDatasources: ["custom.grafana-dashboards"],
      addLabels: ["renovate/grafana-dashboard"],
      commitMessageTopic: "dashboard {{sourceDirectory}}",
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore"
    },
    {
      matchDatasources: ["custom.linux-kernel"],
      // A freshly promoted series is a bare X.Y that semver rejects (update stops silently); the annotation cannot carry versioning.
      versioning: "loose",
      semanticCommitScope: "kernel",
      addLabels: ["renovate/kernel"],
      // Kernel point releases are "patch"; keep them manual.
      automerge: false
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"]
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"]
    }
  ]
}
