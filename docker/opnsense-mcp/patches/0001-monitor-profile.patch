+"""Version-scoped, bounded read-only OPNsense 26.7.8 monitor contract."""
+import asyncio
+import json
+import re
+from datetime import datetime
+
+import httpx
+from fastmcp import Context
+from opnsense_mcp.api_client import OPNsenseAPIError
+
+ALIAS = "Spamhaus_DROP"
+MARKER = "SDROP-20261106-v1"
+MAX_BYTES = 8 * 1024 * 1024
+ROUTES = {
+    "config": ("POST", "firewall/alias/search_item"),
+    "contents": ("POST", "firewall/alias_util/list/Spamhaus_DROP"),
+    "rules": ("POST", "firewall/filter/search_rule"),
+    "metadata": ("GET", "firewall/alias/get_table_size"),
+    "stats": ("GET", "firewall/filter_util/rule_stats"),
+    "ids": ("GET", "diagnostics/firewall/list_rule_ids"),
+    "logs": ("GET", "diagnostics/firewall/log"),
+}
+
+
+def fail(message="Unsupported monitor response"):
+    raise OPNsenseAPIError(message)
+
+
+def integer(value, minimum, maximum):
+    if type(value) is not int or not minimum <= value <= maximum:
+        fail("Monitor numeric bound exceeded")
+
+
+async def read(api, key, body=None, params=None):
+    """No caller-selected method/path; validate exact body/query keys before IO."""
+    if not api._config.monitor_only or key not in ROUTES:
+        fail("Monitor request denied")
+    method, path = ROUTES[key]
+    if key in ("config", "contents", "rules"):
+        expected = {"current", "rowCount", "searchPhrase"} if key == "config" else {"current", "rowCount"}
+        if not isinstance(body, dict) or set(body) != expected or params:
+            fail("Monitor request denied")
+        integer(body["current"], 1, 100 if key != "rules" else 50)
+        integer(body["rowCount"], 1, 100 if key == "rules" else 500)
+        if key == "config" and body["searchPhrase"] != ALIAS:
+            fail("Monitor request denied")
+    elif key == "logs":
+        if body or not isinstance(params, dict) or set(params) - {"limit", "digest"} or "limit" not in params:
+            fail("Monitor request denied")
+        integer(params["limit"], 1, 2000)
+        if "digest" in params and not re.fullmatch(r"[a-f0-9]{32}", params["digest"]):
+            fail("Monitor request denied")
+    elif body or params:
+        fail("Monitor request denied")
+    try:
+        async with asyncio.timeout(15):
+            async with api._client.stream(method, api._config.url.rstrip("/") + "/" + path,
+                                          json=body, params=params, follow_redirects=False,
+                                          timeout=15) as response:
+                if response.status_code != 200:
+                    raise OPNsenseAPIError(f"Monitor HTTP {response.status_code}", response.status_code)
+                data = bytearray()
+                async for chunk in response.aiter_bytes(chunk_size=65536):
+                    data.extend(chunk)
+                    if len(data) > MAX_BYTES:
+                        fail("Monitor response exceeds 8 MiB")
+                result = json.loads(data)
+    except (httpx.HTTPError, TimeoutError, ValueError, UnicodeError):
+        raise OPNsenseAPIError("Monitor transport or JSON unavailable") from None
+    if not isinstance(result, (dict, list)):
+        fail()
+    return result
+
+
+def page_result(data, page, size):
+    if not isinstance(data, dict) or not all(k in data for k in ("rows", "total", "current", "rowCount")):
+        fail()
+    integer(data["total"], 0, 50000)
+    if data["current"] != page or not isinstance(data["rows"], list) or len(data["rows"]) > size:
+        fail()
+    if type(data["rowCount"]) is not int or data["rowCount"] != len(data["rows"]):
+        fail()
+    if not all(isinstance(row, dict) for row in data["rows"]):
+        fail()
+    return {k: data[k] for k in ("rows", "total", "current", "rowCount")}
+
+
+async def request_monitor(api, endpoint, *, page=1, page_size=500, limit=2000, digest=None):
+    integer(page, 1, 100)
+    integer(page_size, 1, 500)
+    integer(limit, 1, 2000)
+    if digest is not None and (not isinstance(digest, str) or not re.fullmatch(r"[a-f0-9]{32}", digest)):
+        fail("Invalid monitor digest")
+    if endpoint not in ROUTES or endpoint == "ids":
+        fail("Monitor endpoint denied")
+    result = {"schema_version": 1}
+    if endpoint in ("contents", "rules"):
+        data = page_result(await read(api, endpoint, {"current":page,"rowCount":page_size}), page, page_size)
+        # Preserve ALL page rows so the collector can prove pagination before filtering.
+        result.update(data)
+    elif endpoint == "config":
+        data = page_result(await read(api, endpoint, {"current":1,"rowCount":500,"searchPhrase":ALIAS}), 1, 500)
+        if data["total"] != len(data["rows"]):
+            fail("Incomplete alias configuration search")
+        matches = [r for r in data["rows"] if r.get("name") == ALIAS]
+        if len(matches) > 1:
+            fail()
+        result["alias"] = matches[0] if matches else None
+    elif endpoint == "metadata":
+        data = await read(api, endpoint)
+        if not isinstance(data, dict) or data.get("status") != "ok" or not isinstance(data.get("details"), dict):
+            fail()
+        result.update(table=data["details"].get(ALIAS), capacity={k:data.get(k) for k in ("size","used")}, refresh_success="unknown")
+    elif endpoint == "stats":
+        data = await read(api, endpoint)
+        ids = await read(api, "ids")
+        if not isinstance(data, dict) or data.get("status") != "ok" or not isinstance(data.get("stats"), dict) or not isinstance(ids, dict) or not isinstance(ids.get("items"), list):
+            fail()
+        result.update(stats=data["stats"], rule_ids=ids["items"])
+    else:
+        params = {"limit":limit}
+        if digest is not None:
+            params["digest"] = digest
+        rows = await read(api, "logs", params=params)
+        if not isinstance(rows, list) or len(rows) > limit or not all(isinstance(r, dict) for r in rows):
+            fail()
+        stamps = []
+        for row in rows:
+            try:
+                stamp = datetime.fromisoformat(row["__timestamp__"])
+                if stamp.tzinfo is None:
+                    break
+                stamps.append(stamp)
+            except (KeyError, ValueError, TypeError):
+                break
+        complete = len(stamps) == len(rows) and bool(rows)
+        result.update(rows=rows, raw_count=len(rows), saturated=len(rows) == limit,
+                      oldest=min(stamps).isoformat() if complete else None,
+                      newest=max(stamps).isoformat() if complete else None,
+                      timestamp_coverage="known" if complete else "unknown",
+                      digest=rows[0].get("__digest__") if rows else None)
+    return result
+
+
+def register(mcp, get_api):
+    @mcp.tool()
+    async def opn_monitor_alias_config(ctx: Context) -> dict:
+        """Read only Spamhaus_DROP configuration; one bounded 500-row search, exact alias match, no refresh."""
+        return await get_api(ctx).request_monitor("config")
+
+    @mcp.tool()
+    async def opn_monitor_alias_contents(ctx: Context, page: int = 1, page_size: int = 500) -> dict:
+        """Read one live Spamhaus_DROP table page (1–100; 1–500 rows). Preserve totals; never update the table."""
+        return await get_api(ctx).request_monitor("contents", page=page, page_size=page_size)
+
+    @mcp.tool()
+    async def opn_monitor_table_metadata(ctx: Context) -> dict:
+        """Read Spamhaus_DROP count hints, counters and content mtime. Successful feed refresh remains unknown."""
+        return await get_api(ctx).request_monitor("metadata")
+
+    @mcp.tool()
+    async def opn_monitor_rules(ctx: Context, page: int = 1, page_size: int = 100) -> dict:
+        """Read one firewall rule page (1–50; 1–100 rows), including legacy rows. Filter the fixed marker after pagination; no writes."""
+        return await get_api(ctx).request_monitor("rules", page=page, page_size=page_size)
+
+    @mcp.tool()
+    async def opn_monitor_rule_stats(ctx: Context) -> dict:
+        """Read bounded UUID/hash counter maps and running rule IDs. Preserve PF expansion counts; never invent identity joins."""
+        return await get_api(ctx).request_monitor("stats")
+
+    @mcp.tool()
+    async def opn_monitor_logs(ctx: Context, limit: int = 2000, digest: str | None = None) -> dict:
+        """Read 1–2000 recent raw firewall log rows, optionally stopping at an upstream MD5 digest. Saturation/time uncertainty is explicit; no full-archive claim."""
+        return await get_api(ctx).request_monitor("logs", limit=limit, digest=digest)
